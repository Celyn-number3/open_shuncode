{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "files": [
    "../editor/src/vscode-dts/vscode.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.defaultChatParticipant.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.chatParticipantAdditions.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.chatParticipantPrivate.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.chatPromptFiles.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.chatProvider.d.ts",
    "../editor/src/vscode-dts/vscode.proposed.languageModelThinkingPart.d.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "dist",
    "runtime",
    "legacy",
    "node_modules"
  ]
}
